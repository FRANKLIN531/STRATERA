# STRATERA database configuration
# Copy this file to .env and fill in your SQL Server details before starting the app.
#   copy .env.example .env

# Default engine: Microsoft SQL Server
STRATERA_DB_TYPE=mssql
STRATERA_DB_HOST=localhost
STRATERA_DB_PORT=1433
STRATERA_DB_NAME=stratera
STRATERA_DB_USER=sa
STRATERA_DB_PASSWORD=change-me
# Set to true when connecting with encryption (Azure / remote). Local Express often uses false.
STRATERA_DB_SSL=false

# --- Optional: PostgreSQL ---
# STRATERA_DB_TYPE=postgresql
# STRATERA_DB_HOST=localhost
# STRATERA_DB_PORT=5432
# STRATERA_DB_NAME=stratera
# STRATERA_DB_USER=stratera_app
# STRATERA_DB_PASSWORD=change-me
# STRATERA_DB_SSL=false

# --- Optional: local SQLite file (offline / legacy only) ---
# STRATERA_DB_TYPE=sqlite

# --- Sign-up email verification (SendGrid) ---
# Optional. When set, new accounts must verify email via a 6-digit code.
# If unset, STRATERA falls back to HR Settings SMTP, or creates accounts immediately.
# STRATERA_SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
# STRATERA_SENDGRID_FROM=noreply@yourdomain.com
